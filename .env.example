APP_ENV=development
APP_VERSION=1.0.0
ADMIN_PASSWORD=change-this-admin-password
ADMIN_TOKEN=change-this-long-random-token
DATABASE_URL=postgresql+psycopg://fleet:fleet_local_password@db:5432/fleet_intelligence
POSTGRES_DB=fleet_intelligence
POSTGRES_USER=fleet
POSTGRES_PASSWORD=fleet_local_password
DB_PORT=5432
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=25
# Optional OpenAI-compatible chat API. Leave blank to use deterministic data-grounded assistant fallback.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
